{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "version": "1.0.2",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "pagemates@tom-tour.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteActivity",
          "websiteContent",
          "personalCommunications"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "vendor/peerjs.min.js",
      "vendor/nostr.bundle.js",
      "common/i18n-core.js",
      "i18n.js",
      "common/net.js",
      "common/pow.js",
      "rooms.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Pagemates",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "Pagemates",
    "default_panel": "sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    }
  }
}
